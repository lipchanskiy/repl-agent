{
  "name": "repl-agent",
  "version": "0.1.0",
  "description": "MCP server for AI-agent REPL-driven development via Clojure nREPL",
  "license": "MIT",
  "author": "Alexey Lipchanskiy",
  "repository": {
    "type": "git",
    "url": "https://github.com/lipchanskiy/repl-agent.git"
  },
  "homepage": "https://github.com/lipchanskiy/repl-agent#readme",
  "bugs": {
    "url": "https://github.com/lipchanskiy/repl-agent/issues"
  },
  "keywords": ["mcp", "clojure", "nrepl", "repl", "ai", "claude", "copilot"],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "repl-agent": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "edn-data": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
