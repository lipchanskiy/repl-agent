;; repl-agent dev configuration example.
;; Use with: repl-agent --mode dev --port 7888
;;
;; In dev mode the policy file is not required.
;; This file is provided as a reference for future restricted-mode policies.

{:allowed-forms    ["count" "keys" "vals" "class" "type" "meta"
                    "clojure.repl/doc" "clojure.repl/source"
                    "clojure.core/deref" "clojure.core/realized?"]
 :allowed-ns-read  []
 :blocked-ns       []
 :max-timeout-ms   10000
 :log-all-evals    false
 :log-path         "/tmp/repl-agent-dev.log"}
